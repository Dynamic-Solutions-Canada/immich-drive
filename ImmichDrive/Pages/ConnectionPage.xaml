<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImmichDrive.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <Page.Resources>
        <Style x:Key="CodeTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CodeBlockBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="nav.connection" Style="{StaticResource PageTitleStyle}" />
            <TextBlock l10n:Localize.Text="connection.subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBox x:Name="ServerBox" l10n:Localize.Header="connection.server-url"
                             PlaceholderText="https://photos.example.com" />
                    <PasswordBox x:Name="ApiKeyBox" l10n:Localize.Header="connection.api-key"
                                 l10n:Localize.Placeholder="connection.api-key-placeholder" />
                    <StackPanel Spacing="8">
                        <TextBlock l10n:Localize.Text="connection.permissions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock l10n:Localize.Text="connection.permissions-intro"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock l10n:Localize.Text="connection.required" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,4,0,0" />
                        <Border Style="{StaticResource CodeBlockBorderStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="user.read&#x0a;asset.read&#x0a;asset.view&#x0a;asset.download"
                                       Style="{StaticResource CodeTextBlockStyle}" />
                        </Border>
                        <TextBlock x:Name="UserReadNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock l10n:Localize.Text="connection.optional" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,4,0,0" />
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CodeBlockBorderStyle}" HorizontalAlignment="Left">
                                <TextBlock Text="album.read" Style="{StaticResource CodeTextBlockStyle}" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" l10n:Localize.Text="connection.albums"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Style="{StaticResource CodeBlockBorderStyle}" HorizontalAlignment="Left">
                                <TextBlock Text="partner.read" Style="{StaticResource CodeTextBlockStyle}" />
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" l10n:Localize.Text="connection.partners"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Grid.Row="2" Style="{StaticResource CodeBlockBorderStyle}" HorizontalAlignment="Left">
                                <TextBlock Text="asset.upload" Style="{StaticResource CodeTextBlockStyle}" />
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" l10n:Localize.Text="connection.upload"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock l10n:Localize.Text="connection.not-needed"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Grid.Column="0" IsReadOnly="True"
                                 l10n:Localize.Header="connection.folder" />
                        <Button x:Name="ChangeFolderButton" Grid.Column="1" l10n:Localize.Content="connection.change-folder"
                                Click="ChangeFolder_Click" VerticalAlignment="Bottom" />
                    </Grid>

                    <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TestButton" Click="TestButton_Click" l10n:Localize.Content="connection.test" />
                        <Button x:Name="ConnectButton" Click="ConnectButton_Click"
                                Style="{StaticResource AccentButtonStyle}" l10n:Localize.Content="common.connect" />
                        <Button x:Name="DisconnectButton" Click="DisconnectButton_Click" l10n:Localize.Content="common.disconnect" />
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
