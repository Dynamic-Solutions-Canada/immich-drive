<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImmichDrive.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Text="ImmichDrive" Style="{StaticResource PageTitleStyle}" />
            <TextBlock l10n:Localize.Text="app.description" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Drive folder" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="FolderText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressBar x:Name="SyncProgress" Visibility="Collapsed" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PinProgressText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <ProgressBar x:Name="PinProgress" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Style="{StaticResource IconLabelStyle}">
                                <FontIcon Glyph="&#xE838;" Style="{StaticResource ButtonGlyphStyle}" />
                                <TextBlock Text="Open drive folder" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton" Click="RefreshButton_Click">
                            <StackPanel Style="{StaticResource IconLabelStyle}">
                                <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonGlyphStyle}" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RetryButton" Click="RetryButton_Click" Visibility="Collapsed">
                            <StackPanel Style="{StaticResource IconLabelStyle}">
                                <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonGlyphStyle}" />
                                <TextBlock x:Name="RetryText" Text="Try again" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ConfigureButton" Click="ConfigureButton_Click" Content="Set up connection" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
