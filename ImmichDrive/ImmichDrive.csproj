<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>$(SupportedOSPlatformVersion)</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>ImmichDrive</RootNamespace>
    <AssemblyName>ImmichDrive</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Configurations>Debug;Release</Configurations>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ImmichDrive.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet packages ────────────────────────────────────────────── -->
  <ItemGroup>
    <!-- System.Drawing for runtime tray-icon rendering -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />

    <!-- WinUI 3 (Windows App SDK) — Fluent Design, Mica, NavigationView -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />

    <!-- MVVM source generators (ObservableProperty, RelayCommand) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!-- Local asset index (relativePath <-> Immich assetId) -->
    <PackageReference Include="Microsoft.Data.Sqlite" />

    <!-- CVE-2025-6965 (SQLite < 3.50.2 aggregate-term memory corruption). The advisory
         covers SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 with NO patched release yet, so it
         cannot be cleared by upgrading (2.1.11 is the newest and still bundles pre-3.50.2
         SQLite). Not reachable here: SQLite is only a local, app-built index queried with
         hardcoded parameterized statements over the user's own data — there is no
         untrusted-SQL path. Remove this once SQLitePCLRaw ships SQLite >= 3.50.2. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />

    <!-- Structured logging -->
    <PackageReference Include="NLog" />
  </ItemGroup>

  <!-- Content files to copy to output ────────────────────────────── -->
  <ItemGroup>
    <None Remove="Resources\ImmichDrive.ico" />
    <None Remove="Resources\ImmichDrive-Offline.ico" />
    <None Remove="Resources\ImmichDrive.png" />
    <None Remove="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\ImmichDrive.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Muted tray icon shown while the drive can't reach the server (see App.OfflineIconPath). -->
    <Content Include="Resources\ImmichDrive-Offline.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\ImmichDrive.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Generated by the kit's generate-notices.py (npm run generate:notices, HYG-3); ships in the package beside the app -->
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Interface text: one JSON catalog per language, read by WinUIAppKit.Localization.UiText -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Catalogs\*.json" LogicalName="ImmichDrive.Localization.%(Filename).json" />
  </ItemGroup>

  <!-- Shared plumbing: tray, settings store, startup, theme, window chrome, updates (KIT-2). -->
  <ItemGroup>
    <ProjectReference Include="..\external\winui-app-kit\WinUIAppKit\WinUIAppKit.csproj" />
  </ItemGroup>

  <!-- winui-app-kit's shared XAML: styles, the settings window shell, the About page and the Settings rows -->
  <Import Project="..\external\winui-app-kit\Xaml\WinUIAppKit.Xaml.projitems" Label="Shared" />

  <!-- Shared "Our other apps" cross-promo page. Bundled data is the offline
       fallback; the page refreshes its public manifest at runtime. -->
  <Import Project="..\external\promo\PromotedApps.projitems" Label="Shared" />
</Project>
