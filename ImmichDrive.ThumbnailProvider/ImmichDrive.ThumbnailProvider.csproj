<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Out-of-process COM server (a real exe), not an in-proc comhost DLL. The in-proc comhost
         could not host the .NET runtime inside the shell's thumbnail surrogate (activation failed
         with 0x80008093). As an exe we control our own runtime and run with package identity. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <RootNamespace>ImmichDrive.ThumbnailProvider</RootNamespace>
    <AssemblyName>ImmichDrive.ThumbnailProvider</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- The shell-launched provider logs to thumb.log itself and must stay NLog-free, so it does
         not ship the shared NLog config. -->
    <WinUIAppKitIncludeNLogConfig>false</WinUIAppKitIncludeNLogConfig>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" />

    <!-- CVE-2025-6965 (SQLite < 3.50.2). No patched SQLitePCLRaw exists yet (advisory covers
         <= 2.1.11, first_patched_version null); not reachable here (local index, parameterized
         queries only). See the matching note in ImmichDrive.csproj. Remove when SQLite >= 3.50.2 ships. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- Share the Immich client + index reader + path/settings/protected-store helpers with the app
       (linked, not duplicated). These files must stay WinUI-free and trim-safe. -->
  <ItemGroup>
    <Compile Include="..\ImmichDrive\Models\ImmichAsset.cs" Link="Shared\ImmichAsset.cs" />
    <Compile Include="..\ImmichDrive\Services\ImmichClient.cs" Link="Shared\ImmichClient.cs" />
    <Compile Include="..\ImmichDrive\Services\AssetIndex.cs" Link="Shared\AssetIndex.cs" />
    <Compile Include="..\ImmichDrive\Services\SharedPaths.cs" Link="Shared\SharedPaths.cs" />
    <Compile Include="..\ImmichDrive\Services\SettingsFile.cs" Link="Shared\SettingsFile.cs" />
    <Compile Include="..\ImmichDrive\Services\CredentialStore.cs" Link="Shared\CredentialStore.cs" />
    <!-- The kit's protected store, linked as source: it depends on nothing else in the kit (KIT-9). -->
    <Compile Include="..\external\winui-app-kit\WinUIAppKit\Settings\ProtectedStore.cs" Link="Shared\ProtectedStore.cs" />
    <Compile Include="..\external\winui-app-kit\WinUIAppKit\Settings\AtomicFile.cs" Link="Shared\AtomicFile.cs" />
    <Compile Include="..\ImmichDrive\Models\StoredApiKey.cs" Link="Shared\StoredApiKey.cs" />
  </ItemGroup>
</Project>
