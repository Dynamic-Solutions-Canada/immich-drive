#!/usr/bin/env bash
# Run every portable test (TEST-2, TEST-5), found by walking the folders, never a hand-kept list:
#   - each harness project under tests/, through scripts/dotnet (`dotnet run`, non-zero on failure);
#   - each *.Tests.ps1 beside the workflow helpers in .github/scripts/tests/, through scripts/pwsh.
# Pass `harnesses` or `scripts` to run only one kind. The same command works on Linux and in CI.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
only="${1:-all}"
failures=0

# Phase 1: .NET harnesses. Build output folders can hold copied project files; skip them.
if [[ "$only" == "all" || "$only" == "harnesses" ]]; then
    mapfile -t projects < <(
        find tests -name '*.csproj' -not -path '*/bin/*' -not -path '*/obj/*' 2>/dev/null | sort
    )
    for project in "${projects[@]}"; do
        printf 'run-tests: %s\n' "$project"
        scripts/dotnet run --project "$project" || failures=$((failures + 1))
    done
fi

# Phase 2: PowerShell script tests. Each throws on its first failed check, so pwsh exits non-zero.
if [[ "$only" == "all" || "$only" == "scripts" ]]; then
    mapfile -t scripts < <(find .github/scripts -name '*.Tests.ps1' 2>/dev/null | sort)
    for script in "${scripts[@]}"; do
        printf 'run-tests: %s\n' "$script"
        scripts/pwsh -File "$script" || failures=$((failures + 1))
    done
fi

if [[ $failures -gt 0 ]]; then
    printf 'run-tests: %d suite(s) failed.\n' "$failures" >&2
    exit 1
fi
printf 'run-tests: all suites passed.\n'
