#!/usr/bin/env bash
# Run PowerShell 7 for the portable script tests in .github/scripts/tests/.
#
# Uses `pwsh` from PATH when there is one (Windows CI runners have it). Otherwise runs it from the
# .NET SDK container image that global.json pins, which ships pwsh, so a Linux machine needs Docker
# but no host PowerShell install. Same memory cap variable as scripts/dotnet.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile "$@"
fi

if ! command -v docker >/dev/null 2>&1; then
    printf 'scripts/pwsh: needs either PowerShell 7 or Docker; found neither.\n' >&2
    exit 1
fi

sdk_version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$repo_root/global.json" | head -1)"
if [[ -z "$sdk_version" ]]; then
    printf 'scripts/pwsh: could not read the SDK version from global.json.\n' >&2
    exit 1
fi

memory="${KIT_DOTNET_MEMORY:-3g}"

exec docker run --rm \
    --memory "$memory" --memory-swap "$memory" \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -v "$repo_root:/src" \
    -w /src \
    "mcr.microsoft.com/dotnet/sdk:$sdk_version" \
    pwsh -NoProfile "$@"
