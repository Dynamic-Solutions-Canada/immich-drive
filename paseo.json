{
  "worktree": {
    "setup": "git submodule update --init --recursive && lefthook install",
    "teardown": "git submodule deinit --all --force"
  },
  "scripts": {
    "verify-desktop": {
      "command": "npm run verify:desktop"
    },
    "package-desktop-dev": {
      "command": "npm run package:desktop:dev"
    },
    "install-desktop": {
      "command": "npm run install:desktop"
    },
    "package-desktop": {
      "command": "npm run package:desktop"
    },
    "icons": {
      "command": "npm run icons"
    },
    "hero": {
      "command": "npm run hero"
    }
  }
}
